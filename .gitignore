# Claude Code local state, incl. worktrees holding stale duplicates of the site.
# Never ship: the publish root is the repo root.
.claude/

.DS_Store
node_modules/

# Wrangler's local dev state (KV shims, build cache). Created by `wrangler pages dev`,
# regenerated on demand, and never part of a deployment.
.wrangler/

# The publish root IS the repo root, so anything committed here is public.
# Internal-only source material and local scratch artifacts must stay untracked.
assets/spec-sheets/*INTERNAL*
assets/spec-sheets/*.CLEAN.pdf
spec-templates/_preview-*.pdf
design-lab.html
hero-lab.html
